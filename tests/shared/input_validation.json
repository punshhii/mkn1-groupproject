{
  "name": "Проверка ввода администратора",
  "requirements": ["FR-13", "FR-36", "FR-39", "FR-44"],
  "note": "Общий набор для ПС-3 (Python) и ПС-4 (PHP): одна и та же строка команды даёт одинаковый результат. ok — ввод принят; message/field — код ошибки и поле из M06. Интерфейсы конфигурации: eth0, eth1, eth2; существующие правила: 5, 20.",
  "ifaces": ["eth0", "eth1", "eth2"],
  "existing_rules": [5, 20],
  "steps": [
    {"do": "command", "line": "rule add 10 in=eth0 src=192.168.1.0/24 proto=tcp dport=80 action=accept out=eth1,eth2 state=on log=yes", "expect": {"ok": true}},
    {"do": "command", "line": "rule add 10 proto=icmp icmp-type=8 action=goto to=20", "expect": {"ok": true}},
    {"do": "command", "line": "rule add 10 eth-proto=arp action=accept out=eth1", "expect": {"ok": true}},
    {"do": "command", "line": "rule add 10 action=drop comment=\"веб сервер\"", "expect": {"ok": true}},
    {"do": "command", "line": "rule add 0 action=drop", "expect": {"message": "M06", "field": "N"}},
    {"do": "command", "line": "rule add 65536 action=drop", "expect": {"message": "M06", "field": "N"}},
    {"do": "command", "line": "rule add 10 proto=tcp", "expect": {"message": "M06", "field": "action"}},
    {"do": "command", "line": "rule add 10 action=allow", "expect": {"message": "M06", "field": "action"}},
    {"do": "command", "line": "rule add 10 action=drop src=256.0.0.1", "expect": {"message": "M06", "field": "src"}},
    {"do": "command", "line": "rule add 10 action=drop dst=10.0.0.0/33", "expect": {"message": "M06", "field": "dst"}},
    {"do": "command", "line": "rule add 10 action=drop src=10.0.0.9-10.0.0.1", "expect": {"message": "M06", "field": "src"}},
    {"do": "command", "line": "rule add 10 action=drop smac=AA-BB-CC-DD-EE-FF", "expect": {"message": "M06", "field": "smac"}},
    {"do": "command", "line": "rule add 10 action=drop dport=80", "expect": {"message": "M06", "field": "dport"}},
    {"do": "command", "line": "rule add 10 action=drop proto=udp sport=2000-1024", "expect": {"message": "M06", "field": "sport"}},
    {"do": "command", "line": "rule add 10 action=drop proto=tcp icmp-type=8", "expect": {"message": "M06", "field": "icmp-type"}},
    {"do": "command", "line": "rule add 10 action=accept", "expect": {"message": "M06", "field": "out"}},
    {"do": "command", "line": "rule add 10 in=eth0 action=accept out=eth0,eth1", "expect": {"message": "M06", "field": "out"}},
    {"do": "command", "line": "rule add 10 action=accept out=eth9", "expect": {"message": "M06", "field": "out"}},
    {"do": "command", "line": "rule add 10 action=goto to=5", "expect": {"message": "M06", "field": "to"}},
    {"do": "command", "line": "rule add 10 action=goto to=30", "expect": {"message": "M06", "field": "to"}},
    {"do": "command", "line": "rule add 10 action=drop state=on", "expect": {"message": "M06", "field": "state"}},
    {"do": "command", "line": "rule add 10 action=drop colour=red", "expect": {"message": "M06", "field": "colour"}},
    {"do": "command", "line": "rule add 10 action=drop comment=\"незакрытая", "expect": {"message": "M06", "field": "кавычки"}},
    {"do": "command", "line": "rule drop 10", "expect": {"message": "M14"}},
    {"do": "command", "line": "RULE LIST", "expect": {"message": "M14"}},
    {"do": "command", "line": "config set tcp_est_timeout_sec=7200", "expect": {"ok": true}},
    {"do": "command", "line": "config set tcp_est_timeout_sec=0", "expect": {"message": "M06", "field": "tcp_est_timeout_sec"}},
    {"do": "command", "line": "config set arp_forwarding=maybe", "expect": {"message": "M06", "field": "arp_forwarding"}},
    {"do": "command", "line": "user add oper_1 role=ro", "expect": {"ok": true}},
    {"do": "command", "line": "user add ab role=ro", "expect": {"message": "M06", "field": "id"}},
    {"do": "command", "line": "user add oper_1 role=admin", "expect": {"message": "M06", "field": "role"}},
    {"do": "command", "line": "log events show code=E50 from=\"2026-10-20 00:00:00\" to=\"2026-10-21 00:00:00\"", "expect": {"ok": true}},
    {"do": "command", "line": "log events show from=\"2026-10-21 00:00:00\" to=\"2026-10-20 00:00:00\"", "expect": {"message": "M06", "field": "from"}},
    {"do": "command", "line": "log events show from=\"21.10.2026\"", "expect": {"message": "M06", "field": "from"}},
    {"do": "command", "line": "log packets show action=pass in=eth0 rule=0 dport=80", "expect": {"ok": true}},
    {"do": "command", "line": "log packets show action=accept", "expect": {"message": "M06", "field": "action"}},
    {"do": "command", "line": "log packets show page=0", "expect": {"message": "M06", "field": "page"}}
  ]
}
